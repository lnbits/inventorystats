{
  "id": "inventorystats",
  "name": "InventoryStats",
  "short_description": "Inventory health, sales, category, and reorder analytics.",
  "version": "0.2.0",
  "min_lnbits_version": "1.5.6",
  "extension_type": "wasm",
  "wasm": {
    "module": "wasm/module.wasm",
    "exports": [
      {
        "name": "get-inventory-stats",
        "visibility": "authenticated"
      }
    ]
  },
  "ui_routes": [
    {
      "path": "/inventorystats",
      "entrypoint": "ui/admin.html",
      "auth": "user"
    }
  ],
  "api_routes": [
    {
      "method": "GET",
      "path": "/stats",
      "export": "get-inventory-stats",
      "auth": "user"
    }
  ],
  "permissions": [
    {
      "id": "extension.api.request",
      "description": "Read the active user's Inventory items and stock history.",
      "policies": [
        {
          "id": "inventory",
          "access": ["read"]
        }
      ]
    }
  ]
}
